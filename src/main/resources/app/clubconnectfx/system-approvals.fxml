<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="20"
      style="-fx-padding:20;">

    <Label text="Pending Club Admin Requests"
           style="-fx-text-fill:#BB86FC; -fx-font-size:22px; -fx-font-weight:bold;" />

    <TableView fx:id="requestsTable">
        <columns>
            <TableColumn text="Username" prefWidth="150"/>
            <TableColumn text="Club Name" prefWidth="150"/>
            <TableColumn text="Email" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="15">
        <Button text="Approve" style="-fx-background-color:#7C4DFF; -fx-text-fill:white;"
                fx:id="approveBtn"/>
        <Button text="Reject" style="-fx-background-color:#FF5370; -fx-text-fill:white;"
                fx:id="rejectBtn"/>
    </HBox>
</VBox>
