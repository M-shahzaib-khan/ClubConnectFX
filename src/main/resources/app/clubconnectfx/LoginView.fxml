<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.clubconnectfx.LoginController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0a0a, #1a1a2e);">

    <center>
        <VBox alignment="CENTER" spacing="30" prefWidth="420" maxWidth="420">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <!-- Main Container with Card Effect -->
            <VBox alignment="CENTER" spacing="25"
                  style="-fx-background-color: rgba(30, 30, 46, 0.95);
                         -fx-background-radius: 20;
                         -fx-border-color: rgba(124, 77, 255, 0.3);
                         -fx-border-width: 1;
                         -fx-border-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(124, 77, 255, 0.4), 20, 0.3, 0, 0);">
                <padding>
                    <Insets top="50" right="40" bottom="50" left="40"/>
                </padding>

                <!-- Logo/Brand Section -->
                <VBox alignment="CENTER" spacing="8">
                    <Label text="⚡" style="-fx-font-size: 48px;"/>
                    <Label text="CLUB CONNECT"
                           style="-fx-text-fill: linear-gradient(to right, #BB86FC, #7C4DFF);
                                  -fx-font-size: 36px;
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 2px;"/>
                    <Label text="Welcome back! Please login to continue"
                           style="-fx-text-fill: #8B8B9F;
                                  -fx-font-size: 13px;"/>
                </VBox>

                <!-- Input Fields -->
                <VBox spacing="18" alignment="CENTER">
                    <VBox spacing="8">
                        <Label text="Username"
                               style="-fx-text-fill: #BB86FC;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                        <TextField fx:id="usernameField"
                                   promptText="Enter your username"
                                   prefHeight="45"
                                   style="-fx-background-color: #1F1B24;
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #6B6B7F;
                                          -fx-font-size: 14px;
                                          -fx-background-radius: 10;
                                          -fx-border-color: #2D2833;
                                          -fx-border-width: 1.5;
                                          -fx-border-radius: 10;
                                          -fx-padding: 12 16;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);">
                            <effect>
                                <DropShadow color="rgba(0,0,0,0.2)" radius="8" offsetY="2"/>
                            </effect>
                        </TextField>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Password"
                               style="-fx-text-fill: #BB86FC;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Enter your password"
                                       prefHeight="45"
                                       style="-fx-background-color: #1F1B24;
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: #6B6B7F;
                                              -fx-font-size: 14px;
                                              -fx-background-radius: 10;
                                              -fx-border-color: #2D2833;
                                              -fx-border-width: 1.5;
                                              -fx-border-radius: 10;
                                              -fx-padding: 12 16;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);">
                            <effect>
                                <DropShadow color="rgba(0,0,0,0.2)" radius="8" offsetY="2"/>
                            </effect>
                        </PasswordField>
                    </VBox>
                </VBox>

                <!-- Error Message -->
                <Label fx:id="errorLabel"
                       textFill="#FF5370"
                       style="-fx-font-size: 13px;
                              -fx-background-color: rgba(255, 83, 112, 0.15);
                              -fx-background-radius: 8;
                              -fx-padding: 8 12;
                              -fx-border-color: rgba(255, 83, 112, 0.3);
                              -fx-border-width: 1;
                              -fx-border-radius: 8;"
                       managed="false"
                       visible="false"/>

                <!-- Login Button -->
                <Button text="Login"
                        onAction="#handleLogin"
                        prefHeight="50"
                        maxWidth="Infinity"
                        style="-fx-background-color: linear-gradient(to right, #7C4DFF, #9D68FF);
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(124, 77, 255, 0.5), 15, 0.4, 0, 4);">
                    <effect>
                        <DropShadow color="rgba(124, 77, 255, 0.5)" radius="15" offsetY="4"/>
                    </effect>
                </Button>

                <!-- Divider -->
                <HBox alignment="CENTER" spacing="10">
                    <Separator prefWidth="80"
                               style="-fx-background-color: #2D2833;"/>
                    <Label text="or"
                           style="-fx-text-fill: #6B6B7F;
                                  -fx-font-size: 12px;"/>
                    <Separator prefWidth="80"
                               style="-fx-background-color: #2D2833;"/>
                </HBox>

                <!-- Create Account Link -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Don't have an account?"
                           style="-fx-text-fill: #8B8B9F;
                                  -fx-font-size: 14px;"/>
                    <Hyperlink text="Create Account"
                               onAction="#goToRegister"
                               style="-fx-text-fill: #BB86FC;
                                      -fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-underline: false;
                                      -fx-border-color: transparent;
                                      -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Footer -->
            <Label text="© 2024 Club Connect. All rights reserved."
                   style="-fx-text-fill: #4A4A5E;
                          -fx-font-size: 11px;"/>
        </VBox>
    </center>
</BorderPane>