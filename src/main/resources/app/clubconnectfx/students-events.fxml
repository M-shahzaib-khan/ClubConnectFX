<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.clubconnectfx.StudentEventsController"
            style="-fx-background-color:#0D0D16;"
            prefWidth="900" prefHeight="600">

    <!-- TOP SEARCH BAR -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-padding:20; -fx-background-color:#1A1A2E;">

            <TextField fx:id="searchField" promptText="Search events..."
                       style="-fx-background-color:#1F1B24; -fx-text-fill:white;
                              -fx-background-radius:10; -fx-padding:8;" />

            <Button text="Search" onAction="#searchEvents"
                    style="-fx-background-color:#7C4DFF; -fx-text-fill:white;
                           -fx-background-radius:10; -fx-padding:8 20;" />

            <Label text="All Events"
                   style="-fx-text-fill:#BB86FC; -fx-font-size:22px;
                          -fx-font-weight:bold; -fx-padding:0 0 0 20;" />
        </HBox>
    </top>

    <!-- CENTER EVENT TABLE -->
    <center>
        <TableView fx:id="eventTable" style="-fx-background-color:#141421;">
            <columns>
                <TableColumn fx:id="colName" text="Event Name" prefWidth="160"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colStart" text="Start" prefWidth="80"/>
                <TableColumn fx:id="colEnd" text="End" prefWidth="80"/>
                <TableColumn fx:id="colVenue" text="Venue" prefWidth="120"/>
                <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

    <!-- BOTTOM REGISTER BUTTON -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding:20;">
            <Button text="Register for Selected Event"
                    onAction="#registerForEvent"
                    style="-fx-background-color: linear-gradient(to right,#7C4DFF,#9D68FF);
                           -fx-text-fill:white; -fx-background-radius:12;
                           -fx-padding:12 30; -fx-font-size:16px; -fx-font-weight:bold;" />
        </HBox>
    </bottom>

</BorderPane>
