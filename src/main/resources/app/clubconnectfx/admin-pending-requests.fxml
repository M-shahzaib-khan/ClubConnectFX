<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.clubconnectfx.AdminRequestsController"
      spacing="15"
      style="-fx-background-color: transparent; -fx-padding:20;">

    <Label text="Pending Member Requests"
           style="-fx-text-fill:#BB86FC; -fx-font-size:24px; -fx-font-weight:bold;"/>

    <TableView fx:id="requestsTable" style="-fx-background-color:#141421;">
        <columns>
            <TableColumn fx:id="colId" text="Student ID" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="120"/>
            <TableColumn fx:id="colSemester" text="Semester" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Approve" onAction="#approveSelected"
                style="-fx-background-color:#50fa7b; -fx-text-fill:black;
                       -fx-background-radius:10; -fx-padding:8 16;"/>
        <Button text="Reject" onAction="#rejectSelected"
                style="-fx-background-color:#ff5555; -fx-text-fill:white;
                       -fx-background-radius:10; -fx-padding:8 16;"/>
    </HBox>

</VBox>
