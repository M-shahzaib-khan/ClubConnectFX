<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.clubconnectfx.AdminDashboardController"
            prefWidth="1100" prefHeight="680"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0a0a, #1a1a2e);">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="18" alignment="TOP_CENTER"
              style="-fx-background-color: rgba(25,25,40,0.95);
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(124,77,255,0.35), 25, 0.3, 0, 0);"
              prefWidth="260">

            <Label text="CLUB ADMIN"
                   style="-fx-text-fill:#BB86FC; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Label fx:id="lblAdminInfo"
                   wrapText="true"
                   style="-fx-text-fill:#8B8B9F; -fx-font-size:13px;"/>

            <Separator prefWidth="200"/>

            <Button text="Club Info"
                    onAction="#openClubInfo"
                    style="-fx-background-color: transparent;
                           -fx-text-fill:white; -fx-font-size:16px;"/>

            <Button text="Pending Requests"
                    onAction="#openPendingRequests"
                    style="-fx-background-color: transparent;
                           -fx-text-fill:white; -fx-font-size:16px;"/>

            <Button text="Manage Events"
                    onAction="#openManageEvents"
                    style="-fx-background-color: transparent;
                           -fx-text-fill:white; -fx-font-size:16px;"/>

            <Separator prefWidth="200"/>

            <Button text="Logout"
                    onAction="#logout"
                    style="-fx-background-color: linear-gradient(to right,#7C4DFF,#9D68FF);
                           -fx-text-fill:white; -fx-font-size:15px;
                           -fx-background-radius:10; -fx-padding:10 20;"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding:25;">
            <Label text="Welcome, Club Admin!"
                   style="-fx-text-fill:white; -fx-font-size:26px;"/>
        </StackPane>
    </center>

</BorderPane>
