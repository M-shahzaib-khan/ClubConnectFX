<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.clubconnectfx.AdminClubInfoController"
      spacing="20"
      style="-fx-background-color: transparent; -fx-padding:20;">

    <Label text="Club Overview"
           style="-fx-text-fill:#BB86FC; -fx-font-size:24px; -fx-font-weight:bold;"/>

    <VBox spacing="10"
          style="-fx-background-color:#1A1A2E; -fx-background-radius:15;
                 -fx-padding:20; -fx-effect:dropshadow(gaussian, rgba(124,77,255,0.3),20,0.2,0,0);">

        <Label fx:id="lblClubName"
               style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

        <Label fx:id="lblClubDesc"
               wrapText="true"
               style="-fx-text-fill:#C0C0D0; -fx-font-size:14px;"/>

        <HBox spacing="25">
            <Label fx:id="lblMembers"
                   style="-fx-text-fill:#BB86FC; -fx-font-size:14px;"/>
            <Label fx:id="lblPending"
                   style="-fx-text-fill:#FFB86C; -fx-font-size:14px;"/>
        </HBox>
    </VBox>
</VBox>
