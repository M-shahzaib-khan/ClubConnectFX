<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.clubconnectfx.RegisterController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0a0a, #1a1a2e);">


    <center>
        <VBox alignment="CENTER" spacing="25" maxWidth="450">

            <!-- Card -->
            <VBox spacing="25" alignment="CENTER"
                  style="-fx-background-color: rgba(30,30,46,0.95);
                         -fx-background-radius: 20;
                         -fx-border-color: rgba(124,77,255,0.3);
                         -fx-border-radius: 20;
                         -fx-border-width: 1;
                         -fx-effect: dropshadow(gaussian, rgba(124,77,255,0.4), 20, 0.3, 0, 0);">
                <padding>
                    <Insets top="40" left="40" right="40" bottom="40"/>
                </padding>

                <!-- Title -->
                <VBox alignment="CENTER">
                    <Label text="Create Account"
                           style="-fx-text-fill: linear-gradient(to right,#BB86FC,#7C4DFF);
                                  -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    <Label text="Join the Club Connect community"
                           style="-fx-text-fill:#8B8B9F; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Role Switch -->
                <HBox alignment="CENTER" spacing="10">

                    <fx:define>
                        <ToggleGroup fx:id="roleToggle"/>
                    </fx:define>

                    <ToggleButton text="Student"
                                  fx:id="studentToggle"
                                  toggleGroup="$roleToggle"
                                  selected="true"
                                  style="-fx-background-color:#1F1B24; -fx-text-fill:white;
                         -fx-background-radius:10; -fx-padding:8 20;"/>

                    <ToggleButton text="Club Admin"
                                  fx:id="adminToggle"
                                  toggleGroup="$roleToggle"
                                  style="-fx-background-color:#1F1B24; -fx-text-fill:white;
                         -fx-background-radius:10; -fx-padding:8 20;"/>
                </HBox>


                <!-- Dynamic Form Container -->
                <StackPane fx:id="formContainer"
                           prefWidth="400"
                           style="-fx-background-color: transparent;">
                </StackPane>

                <!-- Error Label -->
                <Label fx:id="errorLabel"
                       visible="false" managed="false"
                       style="-fx-text-fill:#FF5370; -fx-font-size: 13px;
                              -fx-background-color:rgba(255,83,112,0.15);
                              -fx-background-radius:8; -fx-padding:8 12;
                              -fx-border-color:rgba(255,83,112,0.3);
                              -fx-border-width:1; -fx-border-radius:8;"/>

                <!-- Register Button -->
                <Button text="Create Account"
                        onAction="#handleRegister"
                        prefHeight="50" maxWidth="Infinity"
                        style="-fx-background-color: linear-gradient(to right,#7C4DFF,#9D68FF);
                               -fx-text-fill:white; -fx-font-size:16px; -fx-font-weight:bold;
                               -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(124,77,255,0.5)" radius="15" offsetY="4"/>
                    </effect>
                </Button>

                <!-- Back to Login -->
                <Hyperlink text="Back to Login"
                           onAction="#goToLogin"
                           style="-fx-text-fill:#BB86FC; -fx-font-size:14px;
                                  -fx-font-weight:bold; -fx-underline:false;"/>
            </VBox>

        </VBox>
    </center>
</BorderPane>
